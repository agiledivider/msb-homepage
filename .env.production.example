# Copy to `.env` next to docker-compose.prod.yml and fill in.

# image to run (a registry ref once you've pushed it)
IMAGE=msb-homepage:latest
PORT=3000

# required: long random string — generate with `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string

# required: public URL of this deployment
NEXT_PUBLIC_SERVER_URL=https://your-domain.example

# optional: seed a ready-to-use admin on a fresh DB (roles + permissions are
# always seeded). Leave blank to create the first user via /admin instead.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# --- Kanidm SSO (OIDC) -----------------------------------------------------
# Optional. Set all three of ISSUER/CLIENT_ID/CLIENT_SECRET to add a "Sign in
# with Kanidm" button to /admin/login (email/password login stays available).
# Leave blank for password-only. See src/plugins/oidc for the Kanidm CLI setup.
KANIDM_ISSUER=
KANIDM_CLIENT_ID=
KANIDM_CLIENT_SECRET=
# Email/password login to the CMS. Default off: Kanidm only. Set to on only as
# emergency access when Kanidm fails, then recreate the app container (DEPLOY.md).
# PASSWORD_LOGIN=off

# Editorial roles come from a Kanidm claim map that emits clean role values
# (admin/reviewer/editor) based on group membership — see DEPLOY.md. Optionally
# override the claim name the app reads (default: cms_roles).
# KANIDM_ROLES_CLAIM=cms_roles

# --- Backups (restic) -------------------------------------------------------
# Required. Any restic repository off this server, e.g.
#   s3:https://fsn1.your-objectstorage.com/msb-backup   (+ AWS_* keys below)
#   b2:msb-backup:homepage                               (+ B2_* keys below)
#   rest:https://user:pass@backup.example/msb             (restic rest-server)
#   sftp:storagebox:msb-homepage                         (Hetzner Storage Box: key in ./backup-ssh)
# RESTIC_PASSWORD encrypts the backups: store it outside this server too
# (password manager); without it no backup can be restored. See DEPLOY.md.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# sftp: only, where the SSH key/config live (default ./backup-ssh)
# BACKUP_SSH_DIR=./backup-ssh
# daily backup time, HH:MM Europe/Berlin (03:30 exists once even on DST days)
# BACKUP_AT=03:30
# optional: healthchecks.io-style URL, pinged on start, success and /fail
# BACKUP_PING_URL=
# optional: ntfy push messages when a backup or restore fails, and when a
# restore replaced the site. On ntfy.sh the topic name is the only protection:
# make it unguessable (e.g. msb-backup-$(openssl rand -hex 8)). Token only for
# a protected topic or your own ntfy server. DEPLOY.md "Alerts".
# BACKUP_NTFY_URL=https://ntfy.sh/msb-backup-<random>
# BACKUP_NTFY_TOKEN=
# BACKUP_NTFY_TITLE=Homepage-Backup (staging)
# Required. Shared secret between the CMS and the backup service, for the
# backups view in the admin. Generate with: openssl rand -hex 32
BACKUP_API_TOKEN=

# optional: label on the SSO button
# KANIDM_BUTTON_LABEL=Mit MakerSpace-Konto anmelden
