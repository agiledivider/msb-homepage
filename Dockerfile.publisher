# syntax=docker/dockerfile:1
# Publisher: builds the static snapshot and pushes the nginx image to the registry.
#
# Runs alongside the Payload container (docker-compose.local.yml). It is a
# *worker*, not a website: nothing but Payload talks to it, over the internal
# network, and only after Payload has checked the caller's role.
#
# It deliberately has no Docker socket. `crane` assembles and pushes the OCI
# image directly, so a container that a web button can invoke never holds
# root-equivalent access to the host.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@11.0.8 --activate

# ---- dependencies (native build scripts: sharp, libsql, …) ----
FROM base AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.dangerouslyAllowAllBuilds=true

# ---- runtime ----
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Berlin

# crane: daemonless image assembly + push (static Go binary, ~20 MB).
ARG CRANE_VERSION=0.20.2
ARG TARGETARCH=amd64
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar \
  && curl -sSL "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz" \
     | tar -xz -C /usr/local/bin crane \
  && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# The publisher needs the whole app: it runs a real `next build` + crawl.
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Builds are CPU/RAM hungry; keep them off the Payload container's back.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://localhost:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node_modules/.bin/tsx", "scripts/publisher-server.ts"]
