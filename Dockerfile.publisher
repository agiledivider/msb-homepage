# syntax=docker/dockerfile:1
# Publisher: builds the static snapshot and pushes the nginx image to the registry.
#
# Runs alongside the Payload container (docker-compose.local.yml). It is a
# *worker*, not a website: nothing but Payload talks to it, over the internal
# network, and only after Payload has checked the caller's role.
#
# It deliberately has no Docker socket. `crane` assembles and pushes the OCI
# image directly, so a container that a web button can invoke never holds
# root-equivalent access to the host.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@11.0.8 --activate

# ---- dependencies (native build scripts: sharp, libsql, …) ----
FROM base AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.dangerouslyAllowAllBuilds=true \
  # `next build` needs the build toolchain (typescript, tailwind, @types), but not
  # the linter or the test runner (S6.8). Tests stay out of the build context
  # (.dockerignore), so its type-check never meets them.
  && rm -rf node_modules/@biomejs node_modules/vitest \
     node_modules/.pnpm/@biomejs+* node_modules/.pnpm/vitest@* node_modules/.pnpm/@vitest+* \
     node_modules/.pnpm/vite@* node_modules/.pnpm/rolldown@* node_modules/.pnpm/@rolldown+*

# ---- runtime ----
# Plain Node, no package manager: everything runs through node_modules/.bin,
# and npm / corepack only add size and scan findings (S6.8).
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Berlin NEXT_TELEMETRY_DISABLED=1
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
     /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# crane: daemonless image assembly + push (static Go binary, ~20 MB).
# The asset name must follow the image's own architecture — an x86_64 binary in
# an arm64 image (what an Apple-Silicon host builds by default) simply won't run.
# openssh-client: the post-push deploy step SSHes to the web host to roll out
# the new static image (see scripts/publisher-server.ts / DEPLOY.md).
ARG CRANE_VERSION=0.20.2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tar openssh-client \
  && case "$(uname -m)" in \
       x86_64)  CRANE_ARCH=x86_64 ;; \
       aarch64) CRANE_ARCH=arm64 ;; \
       *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
     esac \
  && curl -sSL "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_${CRANE_ARCH}.tar.gz" \
     | tar -xz -C /usr/local/bin crane \
  && crane version \
  && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# The publisher needs the whole app: it runs a real `next build` + crawl.
COPY --from=deps /app/node_modules ./node_modules
# Rarely changed assets first, then the code (S6.10), so a code change doesn't
# re-ship them. uploads/ only feeds the app's seeds; the publisher never seeds.
COPY public ./public
COPY --exclude=uploads --exclude=public . .

# src/payload-types.ts is git-ignored (and excluded from the build context), so
# generate it into the image — the runtime `next build` type-checks against it.
# Placeholders are inline (not ENV) so no build value persists in the image.
RUN PAYLOAD_SECRET=build-placeholder DATABASE_URI=file:/tmp/build.db node_modules/.bin/payload generate:types

# Builds are CPU/RAM hungry; keep them off the Payload container's back.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://localhost:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node_modules/.bin/tsx", "scripts/publisher-server.ts"]
