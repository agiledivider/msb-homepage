# Copy to `.env` next to docker-compose.local.yml and fill in.
# NEVER commit the real `.env` (it's gitignored).

# --- Payload ---------------------------------------------------------------
# required: long random string — generate with `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# where you reach the admin (live preview links are built from this)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000

# optional: seed a ready-to-use admin on a fresh DB (roles + permissions are
# always seeded). Leave blank to create the first user via /admin.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# --- Kanidm SSO (OIDC) -----------------------------------------------------
# Optional. Set all three of ISSUER/CLIENT_ID/CLIENT_SECRET to add a "Sign in
# with Kanidm" button to /admin/login (email/password login stays available).
# Leave blank for password-only. See src/plugins/oidc for the Kanidm CLI setup.
# Register the redirect URL in Kanidm as:
#   <NEXT_PUBLIC_SERVER_URL>/api/users/oauth/kanidm/callback
KANIDM_ISSUER=
KANIDM_CLIENT_ID=
KANIDM_CLIENT_SECRET=

# Editorial roles come from a Kanidm claim map that emits clean role values
# (admin/reviewer/editor) based on group membership — see DEPLOY.md. Optionally
# override the claim name the app reads (default: cms_roles).
# KANIDM_ROLES_CLAIM=cms_roles

# --- Publisher -------------------------------------------------------------
# shared secret between payload and publisher — generate with `openssl rand -hex 32`
PUBLISH_TOKEN=change-me-to-a-long-random-string

# PUBLIC origin of the *published* site. Compiled into the bundle (metadataBase,
# sitemap.xml, robots.txt, iCal), so it is NOT this stack's address.
PUBLIC_SITE_URL=https://msb-demo.idiot.games

# where the built image is pushed; the serving host pulls this
STATIC_IMAGE=ghcr.io/agiledivider/msb-demo
TAG=latest
PLATFORM=linux/amd64

# nightly rebuild, local (Europe/Berlin) hour
PUBLISH_NIGHTLY_HOUR=3
# quiet period before an auto-triggered publish runs, ms (default 5 min)
PUBLISH_DEBOUNCE_MS=300000

# push the built image to the registry. Leave false for local testing so a run
# can never overwrite the production tag.
PUSH_IMAGE=false

# registry credentials, only needed when PUSH_IMAGE=true.
# A mounted ~/.docker does NOT work on Docker Desktop: it keeps the token in the
# OS keychain (credsStore), leaving the config entry empty, so an in-container
# crane finds no credentials. Pass a token instead — a GitHub PAT with
# `write:packages`:
#   GHCR_USER=<your github username>
#   GHCR_TOKEN=<the PAT>
GHCR_USER=
GHCR_TOKEN=
