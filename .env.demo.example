# Copy to `.env` next to docker-compose.demo.yml and fill in.
# NEVER commit the real `.env` (it's gitignored).

# required: long random string — generate with `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Let's Encrypt registration email for the cert (acme-companion)
LETSENCRYPT_EMAIL=office@makerspacebonn.de

# optional: seed a ready-to-use admin on the fresh DB so you can log into /admin
# immediately (roles + permissions are always seeded). Leave blank to create the
# first user manually via /admin.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
