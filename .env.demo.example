# Copy to `.env` next to docker-compose.demo.yml and fill in.
# NEVER commit the real `.env` (it's gitignored).
#
# The demo serves the statically published site (nginx + dist/), so there is no
# PAYLOAD_SECRET, no database and no admin seeding here — the whole site is
# baked into the image by `pnpm release:static`.

# Let's Encrypt registration email for the cert (acme-companion)
LETSENCRYPT_EMAIL=office@makerspacebonn.de

# optional: pin a specific image tag instead of `latest` — e.g. a git sha, to
# roll back a bad release.
# TAG=latest
