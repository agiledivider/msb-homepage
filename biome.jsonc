{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  // support.js / image-slot.js: helpers of the original .dc.html prototype, not app code.
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/*.html",
      "!src/migrations",
      "!support.js",
      "!image-slot.js",
      "!src/app/(payload)/admin/importMap.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  // CSS: parse Tailwind v4 at-rules (@theme etc.) so it gets linted; no CSS formatting,
  // it would collapse the hand-aligned comment columns of the palette in globals.css.
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "enabled": false }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
