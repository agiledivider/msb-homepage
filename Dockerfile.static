# syntax=docker/dockerfile:1
# Static-site image: serves the pre-built `dist/` snapshot with nginx.
#
#   pnpm publish:static                                   # produces ./dist + ./nginx.conf
#   docker build -f Dockerfile.static -t msb-static .
#   docker run --rm -p 8080:80 msb-static                  # → http://localhost:8080
#
# The image contains only static files — no Node, no database, no Payload. The
# regular Dockerfile still builds the Payload app; that's how the CMS runs.

FROM nginx:1.27-alpine

# Generated alongside dist/ (clean URLs, legacy Joomla 301s, cache headers).
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -q -O /dev/null http://localhost/ || exit 1
