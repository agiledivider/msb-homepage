    "@payloadcms/richtext-lexical": "3.85.2",
    "graphql": "^16.9.0",
    "next": "16.2.10",
    "payload": "3.85.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bufferutil": "^4.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "utf-8-validate": "^6.0.6"
  },
