{
  "name": "msb-homepage",
  "version": "1.0.0",
  "description": "MakerSpace Bonn homepage — Payload CMS 3 + Next.js",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "dev:start": "scripts/dev-server.sh start",
    "dev:stop": "scripts/dev-server.sh stop",
    "dev:restart": "scripts/dev-server.sh restart",
    "dev:status": "scripts/dev-server.sh status",
    "dev:logs": "scripts/dev-server.sh logs",
    "build": "next build",
    "start": "next start",
    "publish:static": "tsx scripts/publish-static.ts",
    "release:static": "scripts/release-static.sh",
    "release:app": "scripts/release-app.sh",
    "publisher": "tsx scripts/publisher-server.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "seed": "payload run src/seed/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@payloadcms/db-sqlite": "3.85.2",
    "@payloadcms/live-preview-react": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@payloadcms/ui": "3.85.2",
    "graphql": "^16.9.0",
    "next": "16.2.10",
    "payload": "3.85.2",
    "payload-oauth2": "1.0.21",
    "payload-rbac-plugin": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bufferutil": "^4.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "utf-8-validate": "^6.0.6"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "packageManager": "pnpm@11.0.8"
}
