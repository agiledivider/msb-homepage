# Build context for Dockerfile (app) and Dockerfile.publisher: an allowlist.
# Everything is out unless named below, so local-only files (backups in
# .backup-dev, the deploy key in deploy/, .env, scratch) can never land in an
# image, and a docs- or test-only commit leaves the context unchanged, letting
# CI reuse every cached layer (S6.8, S6.10). Need a new file in the image?
# Add it here. (Dockerfile.static and Dockerfile.backup have their own lists.)
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.mjs
!next-env.d.ts
!postcss.config.mjs
!tsconfig.json
!src
!public
!uploads
!scripts

# generated in-image (generate:types): never ship a stale local copy
src/payload-types.ts
# runtime uploads (prod uses a volume)
public/media
# local cruft inside the allowed folders
**/.DS_Store
**/*.md
**/*.db
**/*.db-*
